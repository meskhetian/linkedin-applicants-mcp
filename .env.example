# Where the SQLite DB, Chrome profile, downloaded resumes, exports and logs live
LINKEDIN_MCP_DATA_DIR=~/.linkedin-applicants-mcp

# persistent = launch your installed Google Chrome with a dedicated profile dir (default)
# cdp        = attach to a Chrome you started yourself with scripts/launch-chrome.sh
LINKEDIN_MCP_BROWSER_MODE=persistent
LINKEDIN_MCP_CDP_URL=http://127.0.0.1:9222
# chrome | msedge | chromium (must be installed; we never download a browser)
LINKEDIN_MCP_CHROME_CHANNEL=chrome

# How full profiles are extracted:
#   auto    = visit the profile like a person, then one in-page Voyager request; fall back to page text (default)
#   voyager = Voyager only (fails if LinkedIn retires the endpoint)
#   dom     = never call LinkedIn's internal API; read rendered text of the profile + details pages (more page views)
LINKEDIN_MCP_PROFILE_STRATEGY=auto

# Pacing defaults (all overridable at runtime with the pacing_set tool; persisted overrides win)
LINKEDIN_MCP_SPEED=normal          # slow | normal | brisk
LINKEDIN_MCP_WORK_HOURS=09:00-19:00
LINKEDIN_MCP_WORK_DAYS=1,2,3,4,5   # 0=Sunday … 6=Saturday
#LINKEDIN_MCP_TIMEZONE=Europe/Berlin   # default: system time zone
LINKEDIN_MCP_DAILY_APPLICANT_CAP=120     # application detail pages per day
LINKEDIN_MCP_DAILY_PROFILE_CAP=80        # full profile views per day
LINKEDIN_MCP_HOURLY_ACTION_CAP=40        # LinkedIn page actions per rolling hour
LINKEDIN_MCP_RAMP_START=25               # day-1 cap; grows by RAMP_PER_DAY until the caps above (0 disables)
LINKEDIN_MCP_RAMP_PER_DAY=10
LINKEDIN_MCP_SAVE_PDF_MONTHLY_CAP=150    # LinkedIn's own limit is 200/month

# Start the background worker together with the MCP server (it only acts when tasks are queued)
LINKEDIN_MCP_AUTOSTART_WORKER=true

# Persist every captured LinkedIn JSON/RSC response under <data>/debug/raw (heavy; for reverse-engineering)
LINKEDIN_MCP_CAPTURE_RAW=false

LINKEDIN_MCP_LOG_LEVEL=info        # debug | info | warn | error
